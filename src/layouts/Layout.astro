---
import Navbar from "@/components/Navbar.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import CornerPixels from "@/components/landing/CornerPixels.astro";
import PageLoader from "@/components/PageLoader.astro";
import TopPixels from "@/components/TopPixels.astro";
import "lenis/dist/lenis.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Pixel corners at the top and bottom of the page; the home page draws its own */
  decor?: boolean;
}

const {
  title = "Sahyadri Open Source Community (SOSC)",
  description = "SOSC (Sahyadri Open-Source Community) brings together young tech enthusiasts in Mangalore through workshops, DevHost, Hackathons, and open-source collaboration.",
  image = "/og-image.jpg",
  decor = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/Inter.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Sahyadri Open Source Community, SOSC, Mangalore, open-source, student workshops, DevHost, hackathon"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Sahyadri Open-Source Community" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SOSC Mangalore" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:site" content="@sosc_sahyadri" />
    <ClientRouter />
    <script>
      import Lenis from "lenis";

      // Native scrolling for visitors who ask for reduced motion
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ autoRaf: true });

        // Expose lenis to window for global access (e.g. scroll locking)
        (window as any).lenis = lenis;

        // A smooth scroll still gliding when a link is clicked would carry on
        // into the new page and drag it back down. Stop it before the swap so
        // Astro's own scroll (top, back/forward restore, #anchor) sticks.
        document.addEventListener("astro:before-swap", () => lenis.reset());
        document.addEventListener("astro:after-swap", () => lenis.resize());
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:font-bold focus:text-black focus:shadow-lg"
    >
      Skip to content
    </a>
    <PageLoader />
    <Navbar />
    <main id="main" class="relative overflow-clip">
      {decor && <TopPixels />}
      {decor && <CornerPixels corners={["bl", "br"]} page />}
      <div class:list={["relative", decor && "pt-20 pb-8 md:pt-36 md:pb-24"]}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
