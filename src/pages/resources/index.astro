---
import { getCollection } from "astro:content";
import PageHeader from "@/components/PageHeader.astro";
import ResourceBoard from "../../components/resources/ResourceBoard.astro";
import Layout from "../../layouts/Layout.astro";

const resources = await getCollection("resources");

// Sort resources by newest first
const sortedResources = resources.sort((a, b) => {
  if (!a.data.date || !b.data.date) return 0;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<Layout
  title="Resources | SOSC"
  description="Guides, roadmaps, tools and repos curated by SOSC members to help you learn and contribute."
>
  <div class="flex min-h-dvh flex-col">
    <div class="bg-background relative z-0 flex-1 pb-20">
      <div class="mx-auto w-full max-w-7xl px-4 pt-28">
        <PageHeader
          title="Resources"
          count={`${sortedResources.length} Total`}
          blurb="Guides, roadmaps, tools and repos picked by SOSC members to help you learn and start contributing."
        />
      </div>
      <div class="bg-background text-foreground">
        <ResourceBoard resources={sortedResources} />
      </div>
    </div>
  </div>
</Layout>
