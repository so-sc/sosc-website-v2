---
import { ArrowRight } from "@lucide/astro";

interface Props {
  title: string;
  /** Second, green line of the heading */
  accent: string;
  blurb?: string;
  link?: { href: string; label: string };
}

const { title, accent, blurb, link } = Astro.props;
---

<header class="mb-8 flex flex-col items-start justify-between gap-6 border-b border-gray-900 pb-6 md:mb-12 md:flex-row md:items-end md:gap-12 md:pb-8">
  <h2 class="text-[clamp(2.25rem,11vw,3.75rem)] leading-none font-black tracking-tight text-gray-900 uppercase md:text-7xl lg:text-8xl">
    {title}
    <span class="text-primary-ink mt-1 block text-[clamp(1.75rem,8vw,3rem)] md:text-5xl lg:text-6xl">
      {accent}
    </span>
  </h2>

  <div class="flex max-w-sm flex-col items-start gap-4 md:items-end md:text-right">
    {blurb && (
      <p class="text-sm leading-relaxed font-medium text-gray-600">{blurb}</p>
    )}
    {link && (
      <a
        href={link.href}
        class="group hover:text-primary-ink inline-flex items-center gap-2 text-sm font-bold tracking-widest text-gray-900 uppercase transition-colors"
      >
        {link.label}
        <ArrowRight
          class="h-4 w-4 transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    )}
    <slot name="actions" />
  </div>
</header>
