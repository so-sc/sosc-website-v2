---
import { Image } from "astro:assets";

interface Props {
  name: string;
  date: Date;
  location: string;
  cover?: ImageMetadata;
  link: string;
}

const { name, date, location, cover, link } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
});

const today = new Date();
today.setHours(0, 0, 0, 0);
const status =
  date.toDateString() === today.toDateString()
    ? "Today"
    : date > today
      ? "Upcoming"
      : "";

const searchText = `${name} ${location} ${date.getFullYear()}`.toLowerCase();
---

<!-- Phones: compact row (thumbnail beside text). sm+: column tile. -->
<a
  href={`/events/${link}`}
  class="group grid grid-cols-[7rem_1fr] items-start gap-4 sm:grid-cols-1 sm:gap-0"
  data-event
  data-search={searchText}
>
  <div
    class="relative aspect-[4/3] overflow-hidden bg-gray-100 sm:aspect-video"
  >
    {
      cover && (
        <Image
          src={cover}
          alt=""
          width={640}
          height={360}
          format="webp"
          class="h-full w-full object-cover"
        />
      )
    }
    {
      status && (
        <span class="bg-primary text-primary-foreground absolute top-0 left-0 px-2 py-1 text-xs font-bold tracking-widest uppercase">
          {status}
        </span>
      )
    }
  </div>

  <div class="sm:mt-4">
    <time
      datetime={date.toISOString()}
      class="font-mono text-xs font-bold tracking-widest text-gray-500 uppercase"
    >
      {formattedDate}
    </time>
    <h3
      class="group-hover:text-primary-ink mt-1.5 text-base leading-snug font-black text-gray-900 transition-colors sm:text-lg"
    >
      {name}
    </h3>
    <p class="mt-1 line-clamp-1 text-sm text-gray-500">{location}</p>
  </div>
</a>
