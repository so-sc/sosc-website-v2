---
import { ArrowRight } from "@lucide/astro";
import CornerPixels from "./CornerPixels.astro";
import SectionHeader from "./SectionHeader.astro";
---

<!-- Height must match #landing-spacer in Landing.astro: About stays pinned while the hero plays over it -->
<div class="relative z-0 h-[200vh] w-full bg-white">
  <section
    id="about"
    class="sticky top-0 flex min-h-dvh w-full flex-col justify-center overflow-hidden bg-white pt-40 pb-12 md:pt-36 md:pb-18"
  >
    <CornerPixels corners={["tl", "tr"]} />

    <div
      id="about-content"
      class="relative z-10 mx-auto w-full max-w-7xl px-4 md:px-8"
    >
      <SectionHeader
        title="Open Source,"
        accent="Together."
        blurb="A student-driven collective in Mangalore building real-world open-source software."
      />

      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <p class="max-w-xl text-base leading-relaxed text-gray-600 md:text-lg">
            Sahyadri Open Source Community is a student-driven collective where
            everyone learns, collaborates, and builds real-world open source
            solutions.
          </p>

          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            <div class="border-t border-gray-900 pt-4">
              <p class="text-sm font-bold text-gray-900 uppercase">
                Real-world Projects
              </p>
              <p class="mt-2 text-sm leading-snug text-gray-600">
                Build and contribute to impactful open source software.
              </p>
            </div>
            <div class="border-t border-gray-900 pt-4">
              <p class="text-sm font-bold text-gray-900 uppercase">
                Community First
              </p>
              <p class="mt-2 text-sm leading-snug text-gray-600">
                Learn together through collaboration and mentorship.
              </p>
            </div>
          </div>

          <a
            href="/projects"
            class="group hover:border-primary hover:text-primary-ink mt-10 inline-flex items-center gap-3 border border-gray-900 px-6 py-3 text-sm font-bold tracking-widest text-gray-900 uppercase transition-colors"
          >
            Explore our work
            <ArrowRight
              class="h-4 w-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
        </div>

        <!-- Right: visual -->
        <div class="relative hidden md:block">
          <div class="relative mx-auto aspect-4/3 w-full max-w-130 scale-[1.4]">
            <dotlottie-wc
              id="about-lottie"
              src="/about-us-team.lottie"
              loop
              class="h-full w-full"
              style="width: 100%; height: 100%;"
              aria-label="SOSC animation"
            ></dotlottie-wc>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  // The animation only shows from md up, so phones never download the ~680 KB player
  function loadAboutLottie() {
    const el = document.getElementById("about-lottie");
    if (!el || !window.matchMedia("(min-width: 768px)").matches) return;
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.setAttribute("autoplay", "");
    }
    import("@lottiefiles/dotlottie-wc");
  }

  document.addEventListener("astro:page-load", loadAboutLottie);
</script>
