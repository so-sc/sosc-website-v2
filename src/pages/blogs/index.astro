---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowRight, Search } from "@lucide/astro";
import slugify from "slugify";
import BlogCard from "@/components/cards/BlogCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";

const blogs = await getCollection("blogs");

// Tags arrive as "A | B" strings with inconsistent casing; dedupe them
// case-insensitively, keeping the first spelling seen for display
const tagNames = new Map<string, string>();
const splitTags = (raw?: string) =>
  (raw ?? "")
    .split("|")
    .map((t) => t.trim())
    .filter(Boolean);

const posts = blogs
  .map(({ data }) => {
    const tagList = splitTags(data.tags).map((tag) => {
      const key = tag.toLowerCase();
      if (!tagNames.has(key)) tagNames.set(key, tag);
      return tagNames.get(key) as string;
    });
    return {
      title: data.title,
      author: data.author,
      date: data.date,
      description: data.description,
      cover: data.cover,
      link: slugify(data.title, { lower: true, strict: true }),
      tagList: [...new Set(tagList)],
      searchText: [data.title, data.description, data.author, ...tagList]
        .join(" ")
        .toLowerCase(),
    };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const [featured, ...rest] = posts;

// The feed renders this many rows up front and reveals the rest in batches
// as the reader scrolls (see the script below)
const FEED_BATCH = 10;
---

<Layout
  title="Blog | SOSC"
  description="Stories, tutorials and lessons from members of the Sahyadri Open Source Community."
>
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-20 md:px-8">
    <PageHeader
      title="Blog"
      count={`${posts.length} Posts`}
      blurb="Stories, tutorials and lessons from SOSC members: what we built, what broke, and what we learned."
    />

    <!-- Search toolbar -->
    <div
      class="mt-10 flex flex-col gap-3 border-y border-gray-200 py-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <label class="flex flex-1 items-center gap-3">
        <Search class="h-4 w-4 shrink-0 text-gray-500" aria-hidden="true" />
        <span class="sr-only">Search posts</span>
        <input
          id="blog-search"
          type="search"
          placeholder="Search posts, authors, tags…"
          autocomplete="off"
          class="w-full bg-transparent py-1.5 text-sm font-medium text-gray-900 placeholder:text-gray-500"
        />
      </label>
      <p
        id="blog-count"
        class="shrink-0 text-xs font-bold tracking-widest text-gray-500 uppercase"
        aria-live="polite"
      >
        Showing {posts.length} posts
      </p>
    </div>

    <!-- Featured: the newest post as a lead story -->
    {
      featured && (
        <a
          href={`/blogs/${featured.link}`}
          class="group mt-12 grid items-center gap-8 md:grid-cols-12 md:gap-12"
          data-post
          data-search={featured.searchText}
        >
          <div class="aspect-[16/10] overflow-hidden bg-gray-100 md:col-span-7">
            {featured.cover && (
              <Image
                src={featured.cover}
                alt=""
                width={1200}
                height={750}
                format="webp"
                loading="eager"
                class="h-full w-full object-cover"
              />
            )}
          </div>

          <div class="md:col-span-5">
            <p class="flex items-center gap-2 text-xs font-medium text-gray-500">
              <img
                src={`https://github.com/${featured.author}.png?size=64`}
                alt=""
                width="28"
                height="28"
                class="h-7 w-7 rounded-full bg-gray-100"
                onerror="this.onerror=null; this.src='/github_avatar.svg';"
              />
              <span class="font-bold text-gray-900">{featured.author}</span>
              <span aria-hidden="true">·</span>
              <time datetime={featured.date.toISOString()}>
                {featured.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </p>

            <h2 class="group-hover:text-primary-ink mt-4 text-3xl leading-tight font-black text-gray-900 transition-colors md:text-5xl">
              {featured.title}
            </h2>

            <p class="mt-4 line-clamp-3 leading-relaxed text-gray-600">
              {featured.description}
            </p>

            {featured.tagList.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {featured.tagList.map((tag) => (
                  <li class="border border-gray-200 px-2 py-0.5 text-xs font-medium text-gray-600">
                    {tag}
                  </li>
                ))}
              </ul>
            )}

            <span class="group-hover:text-primary-ink mt-8 inline-flex items-center gap-2 text-sm font-bold tracking-widest text-gray-900 uppercase transition-colors">
              Read article
              <ArrowRight
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              />
            </span>
          </div>
        </a>
      )
    }

    <!-- Everything else, newest first -->
    <div
      id="blog-feed"
      class="mt-16 divide-y divide-gray-200 border-t border-gray-900"
    >
      {rest.map((post, i) => <BlogCard {...post} deferred={i >= FEED_BATCH} />)}
    </div>

    <!-- Scrolling near this reveals the next batch of the feed -->
    <div id="blog-feed-sentinel" class="h-px" aria-hidden="true"></div>

    <div id="blog-empty" class="py-20 text-center" hidden>
      <p class="text-gray-500">
        No posts match <span id="blog-empty-tag" class="font-bold text-gray-900"
        ></span> yet.
      </p>
      <button
        type="button"
        id="blog-show-all"
        class="hover:text-primary-ink mt-4 text-sm font-bold tracking-widest text-gray-900 uppercase underline underline-offset-4"
      >
        Show all posts
      </button>
    </div>
  </div>
</Layout>

<script>
  const FEED_BATCH = 10;

  // Feed + search. Rows past the first batch start hidden (their lazy images
  // aren't fetched) and are revealed in batches as the reader nears the end;
  // `content-visibility: auto` on each row lets the browser skip rendering rows
  // far off-screen. Searching looks through every post, loaded or not.
  // Without JS the first batch stays visible.
  let observer: IntersectionObserver | undefined;

  function initBlogFeed() {
    observer?.disconnect();
    const input = document.getElementById(
      "blog-search",
    ) as HTMLInputElement | null;
    const posts = [...document.querySelectorAll<HTMLElement>("[data-post]")];
    const sentinel = document.getElementById("blog-feed-sentinel");
    const count = document.getElementById("blog-count");
    const empty = document.getElementById("blog-empty");
    const emptyTag = document.getElementById("blog-empty-tag");
    if (!input || !posts.length) return;

    // The featured post is always loaded; the feed counts from the list rows
    let limit = 1 + FEED_BATCH;

    const apply = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      const searching = words.length > 0;
      const matches = posts.filter((post) =>
        words.every((w) => (post.dataset.search ?? "").includes(w)),
      );

      posts.forEach((post) => {
        const index = matches.indexOf(post);
        post.hidden = index === -1 || (!searching && index >= limit);
      });

      if (count) {
        const total = matches.length;
        count.textContent = `${searching ? "Found" : "Showing"} ${total} ${total === 1 ? "post" : "posts"}`;
      }
      if (empty) empty.hidden = matches.length > 0;
      if (emptyTag) emptyTag.textContent = `“${input.value.trim()}”`;
      // Only the plain feed paginates; search results show in full
      if (sentinel) sentinel.hidden = searching || limit >= matches.length;
    };

    input.addEventListener("input", apply);
    document.getElementById("blog-show-all")?.addEventListener("click", () => {
      input.value = "";
      apply();
      input.focus();
    });

    if (sentinel) {
      observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting) || sentinel.hidden) return;
          limit += FEED_BATCH;
          apply();
        },
        // Start loading well before the reader reaches the end
        { rootMargin: "800px 0px" },
      );
      observer.observe(sentinel);
    }

    // Browsers may restore a typed query on back/forward
    apply();
  }

  document.addEventListener("astro:page-load", initBlogFeed);
</script>

<style>
  /* Rows far off-screen skip layout and paint; the intrinsic size keeps the
     scrollbar stable while they're skipped */
  #blog-feed :global([data-post]) {
    content-visibility: auto;
    contain-intrinsic-size: auto 18rem;
  }
</style>
