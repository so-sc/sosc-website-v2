---
/* The single page shell for home sections, so every edge lines up with the
   inner pages (max-w-7xl, px-4 / md:px-8). `decor` lists the corners that get
   the pixel motif (see CornerPixels). */
import CornerPixels from "./CornerPixels.astro";

interface Props {
  id?: string;
  class?: string;
  decor?: ("tl" | "tr" | "bl" | "br")[];
}

const { id, class: className, decor = [] } = Astro.props;
---

<section
  id={id}
  class:list={["relative w-full overflow-hidden py-12 md:py-18", className]}
>
  {decor.length > 0 && <CornerPixels corners={decor} />}
  <div class="relative mx-auto max-w-7xl px-4 md:px-8">
    <slot />
  </div>
</section>
