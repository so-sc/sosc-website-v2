// Blurred build-time placeholders keep slow connections from showing raw alt text
const members = await Promise.all(
  teamMembers.map(async (member) => ({
    ...member,
    placeholder: await lqip(member.image),
  })),
);
---

<Section id="team" class="z-10">
  <SectionHeader
    title="Community"
    accent="Members"
    blurb="People who build, mentor, and ship together."
    link={{ href: "/team", label: "Meet the full team" }}
  />

  <div class="team-list">
    {members.map((member) => (
      <div class="team-item">
        <div class="tags-column">
          {member.tags.map((tag) => (
            <span class="member-tag">{tag}</span>
          ))}
        </div>

        <div class="row-image-container">
          <img
            src={member.image}
            alt={member.name}
            loading="lazy"
            decoding="async"
            style={
              member.placeholder
                ? `background-image: url("${member.placeholder}")`
                : undefined
            }
          />
        </div>

        <div class="name-column">
          <span class="member-name">{member.name}</span>
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  /* Scoped to the list so the sizing knobs don't leak to the whole page */
  .team-list {
    --image-width: 25vw;
    --image-height: 32vw;
  }

  .team-item {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    column-gap: 2rem;
    min-height: 6rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid #000;
    cursor: default;
    position: relative;
  }

  .tags-column {
    grid-column: span 5 / span 5;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    z-index: 2;
  }

  .member-tag {
    padding: 3px 12px;
    border: 1px solid var(--primary);
    border-radius: 0; /* Sharp corners */
    font-size: 0.75rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: transparent;
    transition: all 0.25s ease;
    font-weight: bold;
  }

  .team-item:hover .member-tag {
    background-color: var(--primary);
    color: var(--primary-foreground);
  }

  .name-column {
    grid-column: 7 / span 6;
    z-index: 2;
  }

  .member-name {
    font-size: 1.25rem;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .member-name {
      font-size: 2rem;
    }
  }

  /*
    CENTERED IMAGE
    Appears only on hover
  */
  .row-image-container {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);

    width: var(--image-width);
    height: var(--image-height);
    pointer-events: none;
    z-index: 60;
    opacity: 0;
    display: none;
  }

  .team-item:hover .row-image-container {
    opacity: 1;
    display: block;
  }

  .row-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Placeholder shows through until the photo paints; alt text never renders */
    background-color: #f3f4f6;
    background-size: cover;
    background-position: center;
    color: transparent;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 768px) {
    .team-item {
      grid-template-columns: 80px 1fr;
      grid-template-areas:
        "image name"
        "image tags";
      gap: 12px 16px;
      padding: 16px 0;
    }

    .row-image-container {
      grid-area: image;
      position: relative;
      left: 0;
      top: 0;
      transform: none;
      width: 80px;
      height: 100px;
      display: block !important;
      opacity: 1;
      pointer-events: auto;
    }

    .name-column {
      grid-area: name;
      grid-column: auto;
      z-index: 2;
    }

    .tags-column {
      grid-area: tags;
      grid-column: auto;
      justify-content: flex-start;
      gap: 6px;
    }

    .member-tag {
      padding: 1px 8px;
      font-size: 0.65rem;
    }
  }
</style>
