---

<div
  id="page-loader"
  class="pointer-events-none fixed inset-0 z-[90] flex items-center justify-center bg-white opacity-0 transition-opacity duration-200"
  transition:persist
  hidden
>
  <svg
    viewBox="0 0 442.76 191.89"
    class="loader-logo h-auto w-40 md:w-48"
    aria-hidden="true"
  >
    <g transform="translate(-430.73 -150.07)">
      {paths.map((d) => (
        <path d={d} pathLength="1" />
      ))}
    </g>
  </svg>
  <p class="sr-only" role="status">
    Loading page
  </p>
</div>

<style>
  .loader-logo path {
    fill: var(--primary);
    fill-opacity: 0;
    stroke: var(--primary);
    stroke-width: 3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: fill-opacity 0.35s ease-out;
  }

  /* Draw the outline once each time the loader appears, then hold it */
  #page-loader:not([hidden]) .loader-logo path {
    animation: loader-draw 1s ease-in-out forwards;
  }

  /* Page is ready: fill the mark in before fading out */
  #page-loader.is-filled .loader-logo path {
    fill-opacity: 1;
  }

  @keyframes loader-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #page-loader:not([hidden]) .loader-logo path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // Matches the loader-draw animation; the outline always finishes before filling
  const DRAW = 1000;
  const FILL = 350;
  const FADE = 200;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;
  let shownAt = 0;

  const loader = () => document.getElementById("page-loader");

  // Shows on every navigation, so the logo always draws, fills and fades
  const show = () => {
    clearTimeout(hideTimer);
    const el = loader();
    if (!el) return;
    if (el.hidden) {
      el.classList.remove("is-filled");
      el.hidden = false;
      shownAt = performance.now();
    }
    requestAnimationFrame(() => el.classList.remove("opacity-0"));
  };

  const hide = () => {
    const el = loader();
    if (!el || el.hidden) return;
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const drawLeft = still
      ? 0
      : Math.max(0, DRAW - (performance.now() - shownAt));
    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => {
      el.classList.add("is-filled");
      hideTimer = setTimeout(() => {
        el.classList.add("opacity-0");
        hideTimer = setTimeout(() => (el.hidden = true), FADE);
      }, FILL);
    }, drawLeft);
  };

  document.addEventListener("astro:before-preparation", show);
  document.addEventListener("astro:after-swap", hide);
  document.addEventListener("astro:page-load", hide);
</script>
