---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import slugify from "slugify";
import Layout from "@/layouts/Layout.astro";
import MarkdownLayout from "@/layouts/MarkdownLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: {
      slug: slugify(project.data.title, { lower: true, strict: true }),
    },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  date,
  cover,
  description,
  techStack,
  maintainers,
  status,
  category,
  tags = [],
  github,
  demo,
  documentation,
} = project.data;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const statusLabels: Record<string, string> = {
  active: "Active",
  maintained: "Maintained",
  archived: "Archived",
  completed: "Completed",
  "in-progress": "In Progress",
};
---

<Layout
  title={`${title} | SOSC Projects`}
  description={description}
  image={project.data.cover?.src}
>
  <div class="mx-auto max-w-3xl px-4 pt-24 pb-16 md:px-8 md:pt-28 md:pb-20">
    <!-- Top Back Button -->
    <div class="mb-6 md:mb-8">
      <a
        href="/projects"
        class="group hover:text-primary-ink inline-flex items-center gap-2 text-sm font-bold tracking-wider text-gray-500 uppercase transition-colors"
      >
        <Icon
          name="mdi:chevron-left"
          class="h-4 w-4 transition-transform group-hover:-translate-x-1"
        />
        Back to all projects
      </a>
    </div>

    <!-- Project Header -->
    <div class="mb-8 border-b border-gray-100 pb-8 md:mb-10 md:pb-10">
      <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs font-bold tracking-[0.2em] text-gray-500 uppercase">
        <span class="flex items-center gap-2">
          <span class="bg-primary size-2" aria-hidden="true"></span>
          Project
        </span>
        <span class="text-gray-300" aria-hidden="true">
          /
        </span>
        <span>{category}</span>
        <span
          class:list={[
            "px-2 py-0.5 tracking-wider",
            status === "active" && "bg-green-50 text-green-700",
            status === "maintained" && "bg-blue-50 text-blue-700",
            status === "archived" && "bg-gray-100 text-gray-600",
            status === "completed" && "bg-yellow-50 text-yellow-700",
            status === "in-progress" && "bg-orange-50 text-orange-700",
          ]}
        >
          {statusLabels[status]}
        </span>
      </div>

      <h1 class="text-3xl leading-[1.1] font-black tracking-tight text-balance text-gray-900 sm:text-4xl md:text-5xl">
        {title}
      </h1>

      <p class="mt-3 text-base leading-relaxed text-gray-600 md:mt-4 md:text-lg">
        {description}
      </p>

      <!-- Maintainers & Date -->
      <div class="mt-5 flex items-center gap-3 md:mt-6">
        <div class="flex shrink-0 items-center">
          {maintainers.slice(0, 3).map((maintainer, i) => (
            <a
              href={`https://github.com/${maintainer}`}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative"
              style={i > 0 ? "margin-left: -0.625rem;" : ""}
            >
              <img
                src={`https://github.com/${maintainer}.png`}
                alt={maintainer}
                class="size-9 rounded-full border-2 border-white bg-gray-50 transition-transform group-hover:z-10 group-hover:scale-105 md:size-10"
                loading="eager"
                decoding="async"
                onerror="this.onerror=null; this.src='/github_avatar.svg';"
              />
            </a>
          ))}
          {maintainers.length > 3 && (
            <span
              class="flex size-9 items-center justify-center rounded-full border-2 border-white bg-gray-100 text-xs font-medium text-gray-500 md:size-10"
              style="margin-left: -0.625rem;"
            >
              +{maintainers.length - 3}
            </span>
          )}
        </div>
        <div class="flex min-w-0 flex-col text-sm leading-snug">
          <div class="flex flex-wrap items-center gap-x-2">
            {maintainers.slice(0, 2).map((maintainer, i) => (
              <>
                <a
                  href={`https://github.com/${maintainer}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-primary-ink truncate font-bold text-gray-900 transition-colors"
                >
                  @{maintainer}
                </a>
                {i < Math.min(maintainers.length, 2) - 1 && (
                  <span class="text-gray-300">|</span>
                )}
              </>
            ))}
            {maintainers.length > 2 && (
              <span class="text-xs text-gray-500">
                +{maintainers.length - 2} more
              </span>
            )}
          </div>
          <span class="text-xs text-gray-500">
            Maintainers ·{" "}
            <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
          </span>
        </div>
      </div>

      <!-- Tech Stack & Tags -->
      <div class="mt-5 flex flex-wrap gap-1.5 md:mt-6 md:gap-2">
        {techStack.map((tech) => (
          <span class="hover:border-primary hover:text-primary-ink border border-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors">
            {tech}
          </span>
        ))}
        {tags.map((tag) => (
          <span class="bg-primary/10 px-2.5 py-1 text-xs font-medium text-gray-700">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Action Links -->
      <div class="mt-5 flex flex-wrap items-center gap-3 md:mt-6 md:gap-4">
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 border border-gray-900 bg-gray-900 px-4 py-2 text-xs font-bold tracking-wider text-white uppercase transition-all hover:bg-transparent hover:text-gray-900"
          >
            <Icon name="mdi:github" class="h-4 w-4" />
            View on GitHub
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="group border-primary bg-primary hover:text-primary-ink text-primary-foreground inline-flex items-center gap-2 border px-4 py-2 text-xs font-bold tracking-wider uppercase transition-all hover:bg-transparent"
          >
            <Icon name="mdi:open-in-new" class="h-4 w-4" />
            Live Demo
          </a>
        )}
        {documentation && (
          <a
            href={documentation}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary-ink inline-flex items-center gap-2 text-xs font-bold tracking-wider text-gray-500 uppercase transition-colors"
          >
            <Icon name="mdi:file-document" class="h-4 w-4" />
            Documentation
          </a>
        )}
      </div>
    </div>

    <!-- Project Cover -->
    {cover && (
      <div class="mb-8 overflow-hidden bg-gray-50 md:mb-12">
        <Image
          src={cover}
          alt={title}
          class="h-auto w-full object-cover"
          loading="eager"
          format="webp"
          quality={80}
        />
      </div>
    )}

    <!-- Project Markdown Content -->
    <MarkdownLayout>
      <Content />
    </MarkdownLayout>

    <!-- Back to Projects Link -->
    <div class="mt-12 border-t border-gray-100 pt-6 md:mt-16 md:pt-8">
      <a
        href="/projects"
        class="group hover:text-primary-ink inline-flex items-center gap-2 text-sm font-bold tracking-wider text-gray-500 uppercase transition-colors"
      >
        <Icon
          name="mdi:chevron-left"
          class="h-4 w-4 transition-transform group-hover:-translate-x-1"
        />
        Back to all projects
      </a>
    </div>
  </div>
</Layout>
