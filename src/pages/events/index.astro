---
import { getCollection } from "astro:content";
import slugify from "slugify";
import EventCard from "@/components/cards/EventCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";

const events = await getCollection("events");

const parsedEvents = events
  .map(({ data }) => ({
    name: data.name,
    date: data.date,
    location: data.location,
    cover: data.cover,
    link: slugify(data.name, { lower: true, strict: true }),
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout
  title="Events | SOSC"
  description="Workshops, hackathons, DevHost and talks hosted by the Sahyadri Open Source Community since 2017."
>
  <div
    class="mx-auto min-h-[calc(100dvh-4rem)] max-w-7xl px-4 pt-28 pb-20 md:px-8"
  >
    <div class="grid grid-cols-1 gap-8 md:gap-16 lg:grid-cols-12">
      <aside class="relative lg:col-span-4">
        <div class="sticky top-24">
          <PageHeader
            title="Events"
            count={`${parsedEvents.length} Total`}
            blurb="A curated collection of workshops, hackathons, and tech talks. Join us to learn, build, and connect with the community."
          />
        </div>
      </aside>

      <div class="md:pl-4 lg:col-span-8 lg:pl-20">
        <div class="flex flex-col pb-12">
          {parsedEvents.map((event) => <EventCard {...event} />)}
        </div>

        {
          parsedEvents.length === 0 && (
            <div class="flex h-64 items-center justify-center border border-dashed border-gray-200 dark:border-gray-800">
              <p class="font-mono text-sm text-gray-500">No events found.</p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
