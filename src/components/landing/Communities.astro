---
import communities from "@/data/communities.json";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
---

<Section id="communities">
  <SectionHeader
    title="Communities"
    accent="Participating"
    blurb="The communities driving innovation and open source at Sahyadri."
  />

  <div class="divide-y divide-gray-200">
    {communities.map((c) => (
      <article
        class="grid grid-cols-[5.5rem_1fr] items-center gap-x-5 gap-y-6 py-10 first:pt-0 last:pb-0 md:grid-cols-12 md:items-start md:gap-x-12 md:gap-y-4"
        id={`community-${c.id}`}
      >
        {/* Identical square frame per logo, so a square mark and a wide
              wordmark read as equals. Phones: small, beside the name.
              Desktop: large, spanning the name and body. */}
        <div class="flex aspect-square w-full items-center justify-center border border-gray-200 bg-white p-2.5 md:col-span-3 md:row-span-2 md:p-6">
          <img
            src={c.logo}
            alt={`${c.name} logo`}
            width="400"
            height="400"
            class="h-full w-full object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>

        <h3 class="text-primary-ink text-3xl font-black uppercase sm:text-4xl md:col-span-9 md:text-5xl">
          {c.name}
        </h3>

        <div class="col-span-2 md:col-span-9 md:col-start-4">
          <p class="max-w-3xl text-gray-600 md:text-lg">{c.description}</p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {c.points.map((point) => (
              <div class="border-t border-gray-900 pt-4">
                <p class="text-sm font-bold text-gray-900 uppercase">
                  {point.title}
                </p>
                <p class="mt-2 text-sm leading-snug text-gray-600">
                  {point.content}
                </p>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>
