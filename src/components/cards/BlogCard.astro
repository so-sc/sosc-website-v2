---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  cover?: ImageMetadata;
  date: Date;
  link: string;
  author: string;
  /** Display tags, already normalized */
  tagList: string[];
  /** Lower-cased text the page's search matches against */
  searchText: string;
  /** Rendered hidden; the feed reveals it when the reader scrolls near */
  deferred?: boolean;
}

const {
  title,
  description,
  cover,
  date,
  link,
  author,
  tagList,
  searchText,
  deferred = false,
} = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/blogs/${link}`}
  class="group grid items-start gap-6 py-8 md:grid-cols-12 md:gap-8 md:py-10"
  data-post
  data-search={searchText}
  hidden={deferred}
>
  <div class="aspect-[16/10] overflow-hidden bg-gray-100 md:col-span-4">
    {
      cover && (
        <Image
          src={cover}
          alt=""
          width={640}
          height={400}
          format="webp"
          class="h-full w-full object-cover"
        />
      )
    }
  </div>

  <div class="flex flex-col md:col-span-8">
    <p class="flex items-center gap-2 text-xs font-medium text-gray-500">
      <img
        src={`https://github.com/${author}.png?size=48`}
        alt=""
        width="20"
        height="20"
        class="h-5 w-5 rounded-full bg-gray-100"
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null; this.src='/github_avatar.svg';"
      />
      <span class="font-bold text-gray-900">{author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </p>

    <h2
      class="group-hover:text-primary-ink mt-3 text-xl leading-tight font-black text-gray-900 transition-colors md:text-3xl"
    >
      {title}
    </h2>

    <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-gray-600">
      {description}
    </p>

    {
      tagList.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tagList.map((tag) => (
            <li class="border border-gray-200 px-2 py-0.5 text-xs font-medium text-gray-600">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
