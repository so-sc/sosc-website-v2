{
  "name": "sosc-website-v2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "add": "node cli/index.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "biome check . && prettier --check .",
    "check:fix": "biome check --write . && prettier --write .",
    "type-check": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,astro,json}": [
      "biome check --write --no-errors-on-unmatched",
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/mdi": "^1.2.3",
    "@lottiefiles/dotlottie-wc": "^0.10.0",
    "@lucide/astro": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "fs-extra": "^11.4.1",
    "inquirer": "^14.2.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satteri-imgattr": "^0.1.1",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/typography": "^0.5.20",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0"
  }
}
