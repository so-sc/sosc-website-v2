---
import { getCollection } from "astro:content";
import slugify from "slugify";
import ProjectCard from "@/components/cards/ProjectCard.astro";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

// Same ordering as the projects page: community projects first, then newest
const featured = (await getCollection("projects"))
  .map(({ data }) => ({
    ...data,
    link: slugify(data.title, { lower: true, strict: true }),
  }))
  .sort((a, b) => {
    if (a.community !== b.community) return a.community ? -1 : 1;
    return b.date.getTime() - a.date.getTime();
  })
  .slice(0, 3);
---

<Section id="featured-projects">
  <SectionHeader
    title="What We"
    accent="Build"
    blurb="Open-source projects built and maintained by SOSC and its members."
    link={{ href: "/projects", label: "All projects" }}
  />

  <div class="grid gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-3">
    {featured.map((project) => <ProjectCard {...project} />)}
  </div>
</Section>
