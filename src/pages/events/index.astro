---
import { getCollection } from "astro:content";
import { Search } from "@lucide/astro";
import slugify from "slugify";
import EventCard from "@/components/cards/EventCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";

const events = (await getCollection("events"))
  .map(({ data }) => ({
    name: data.name,
    date: data.date,
    location: data.location,
    cover: data.cover,
    link: slugify(data.name, { lower: true, strict: true }),
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// Archive grouped by year, newest year first
const years = [...new Set(events.map((e) => e.date.getFullYear()))].map(
  (year) => ({
    year,
    events: events.filter((e) => e.date.getFullYear() === year),
  }),
);
---

<Layout
  title="Events | SOSC"
  description="Workshops, hackathons, DevHost and talks hosted by the Sahyadri Open Source Community since 2017."
>
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-20 md:px-8">
    <PageHeader
      title="Events"
      count={`${events.length} Total`}
      blurb="Every workshop, hackathon and talk we've run, year by year. Join us to learn, build, and connect with the community."
    />

    <!-- Toolbar: search + jump to a year -->
    <div
      class="mt-10 flex flex-col gap-3 border-y border-gray-200 py-3 lg:flex-row lg:items-center lg:justify-between"
    >
      <label class="flex flex-1 items-center gap-3">
        <Search class="h-4 w-4 shrink-0 text-gray-500" aria-hidden="true" />
        <span class="sr-only">Search events</span>
        <input
          id="event-search"
          type="search"
          placeholder="Search events, places, years…"
          autocomplete="off"
          class="w-full bg-transparent py-1.5 text-sm font-medium text-gray-900 placeholder:text-gray-500"
        />
      </label>
      <label class="flex items-center gap-3">
        <span class="text-xs font-bold tracking-widest text-gray-500 uppercase"
          >Jump to year</span
        >
        <select
          id="event-year"
          class="border border-gray-300 bg-white px-3 py-2 font-mono text-sm font-bold text-gray-900 transition-colors hover:border-gray-900"
        >
          <option value="">Year</option>
          {
            years.map(({ year }) => (
              <option value={year} data-year-option={year}>
                {year}
              </option>
            ))
          }
        </select>
      </label>
    </div>
    <p id="event-count" class="sr-only" aria-live="polite"></p>

    <!-- Year archive -->
    <div class="mt-4">
      {
        years.map(({ year, events: yearEvents }) => (
          <section
            id={`year-${year}`}
            class="year-group grid scroll-mt-24 gap-6 border-b border-gray-200 py-10 last:border-b-0 lg:grid-cols-12 lg:gap-8 lg:py-14"
            data-year-group
            aria-labelledby={`year-${year}-label`}
          >
            {/* Phones: sticky bar under the navbar. Desktop: giant outlined year pinned beside its events. */}
            <header class="sticky top-14 z-10 -mx-4 flex items-baseline justify-between border-b border-gray-200 bg-white/95 px-4 py-2 lg:top-24 lg:col-span-3 lg:mx-0 lg:block lg:self-start lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
              <h2
                id={`year-${year}-label`}
                class="text-primary text-3xl leading-none font-black tracking-tighter lg:text-[7.5rem]"
              >
                {year}
              </h2>
              <p class="font-mono text-xs font-bold tracking-widest text-gray-500 uppercase lg:mt-3">
                <span data-year-count>{yearEvents.length}</span>{" "}
                {yearEvents.length === 1 ? "event" : "events"}
              </p>
            </header>

            <div class="grid gap-5 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:col-span-9 xl:grid-cols-3">
              {yearEvents.map((event) => (
                <EventCard {...event} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div id="event-empty" class="py-20 text-center" hidden>
      <p class="text-gray-500">
        No events match <span
          id="event-empty-query"
          class="font-bold text-gray-900"></span>
      </p>
      <button
        type="button"
        id="event-show-all"
        class="hover:text-primary-ink mt-4 text-sm font-bold tracking-widest text-gray-900 uppercase underline underline-offset-4"
      >
        Show all events
      </button>
    </div>
  </div>
</Layout>

<style>
  /* Off-screen years skip layout and paint; intrinsic size keeps the
     scrollbar steady while they're skipped */
  .year-group {
    content-visibility: auto;
    contain-intrinsic-size: auto 60rem;
  }
</style>

<script>
  // Search across every event; empty years and their jump links hide too.
  // Without JS the full archive stays visible.
  function initEventSearch() {
    const input = document.getElementById(
      "event-search",
    ) as HTMLInputElement | null;
    const groups = document.querySelectorAll<HTMLElement>("[data-year-group]");
    const count = document.getElementById("event-count");
    const empty = document.getElementById("event-empty");
    const emptyQuery = document.getElementById("event-empty-query");
    if (!input || !groups.length) return;

    const apply = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let total = 0;

      groups.forEach((group) => {
        let inYear = 0;
        group.querySelectorAll<HTMLElement>("[data-event]").forEach((ev) => {
          const match = words.every((w) =>
            (ev.dataset.search ?? "").includes(w),
          );
          ev.hidden = !match;
          if (match) inYear++;
        });
        group.hidden = inYear === 0;
        const yearCount = group.querySelector("[data-year-count]");
        if (yearCount) yearCount.textContent = String(inYear);
        const year = group.id.replace("year-", "");
        const option = document.querySelector<HTMLOptionElement>(
          `[data-year-option="${year}"]`,
        );
        if (option) option.hidden = option.disabled = inYear === 0;
        total += inYear;
      });

      if (count) {
        count.textContent = `${total} ${total === 1 ? "event" : "events"} shown`;
      }
      if (empty) empty.hidden = total > 0;
      if (emptyQuery) emptyQuery.textContent = `“${input.value.trim()}”`;
    };

    input.addEventListener("input", apply);

    const jump = document.getElementById(
      "event-year",
    ) as HTMLSelectElement | null;
    jump?.addEventListener("change", () => {
      if (!jump.value) return;
      document
        .getElementById(`year-${jump.value}`)
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
      jump.value = "";
    });
    document.getElementById("event-show-all")?.addEventListener("click", () => {
      input.value = "";
      apply();
      input.focus();
    });
    apply();
  }

  document.addEventListener("astro:page-load", initEventSearch);
</script>
